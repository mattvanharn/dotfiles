#!/bin/bash
set -euo pipefail

# One-command personal backup to USB using rsync.
# Default target matches your current USB mount path.
DEFAULT_TARGET="/run/media/$USER/Ventoy/backup"

DRY_RUN=false
WITH_PROJECTS=false
TARGET="${DEFAULT_TARGET}"

usage() {
  cat <<'EOF'
Usage:
  backup-to-usb [--dry-run] [--with-projects] [target_path]

Options:
  --dry-run        Show what would be copied, without writing.
  --with-projects  Also back up ~/Projects.
  target_path      Override destination root.

Examples:
  backup-to-usb
  backup-to-usb --dry-run
  backup-to-usb --with-projects
  backup-to-usb --dry-run /run/media/phoenician/Ventoy/backup
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --with-projects) WITH_PROJECTS=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) TARGET="$1"; shift ;;
  esac
done

if [[ ! -d "$TARGET" ]]; then
  echo "Backup target does not exist: $TARGET"
  echo "Mount your USB drive, then run again."
  exit 1
fi

available=$(df -BG "$TARGET" | awk 'NR==2 {print $4}' | tr -d 'G')
if (( available < 5 )); then
  echo "Warning: less than 5GB free on $TARGET (${available}GB available)"
  read -r -p "Continue anyway? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || exit 1
fi

TIMESTAMP="$(date +%F_%H%M%S)"
HOST="$(hostname)"
DEST_ROOT="${TARGET}/${USER}/${HOST}/${TIMESTAMP}"

mkdir -p "$DEST_ROOT"

echo "Backing up to: $DEST_ROOT"
echo "Dry run: $DRY_RUN"
echo

RSYNC_OPTS=(
  -a
  --no-links
  --human-readable
  --info=progress2
  --exclude ".cache/"
  --exclude ".local/share/Trash/"
  --exclude ".venv/"
  --exclude "venv/"
  --exclude "__pycache__/"
  --exclude "*.pyc"
  --exclude "node_modules/"
  --exclude ".git/"
)

RSYNC_OPTS_PROJECTS=(
  "${RSYNC_OPTS[@]}"
  --exclude "*.gguf"
  --exclude "*.pt"
  --exclude "*.pth"
  --exclude "*.safetensors"
  --exclude "*.bin"
  --exclude "data/"
  --exclude "datasets/"
)

if [[ "$DRY_RUN" == true ]]; then
  RSYNC_OPTS+=(--dry-run --itemize-changes)
  RSYNC_OPTS_PROJECTS+=(--dry-run --itemize-changes)
fi

backup_if_exists() {
  local src="$1"
  local rel="$2"
  local -n opts_ref="${3:-RSYNC_OPTS}"

  if [[ -e "$src" ]]; then
    mkdir -p "${DEST_ROOT}/${rel}"
    if [[ -d "$src" ]]; then
      rsync "${opts_ref[@]}" "$src/" "${DEST_ROOT}/${rel}/" || echo "Warning: some files from $src were not fully transferred"
    else
      rsync "${opts_ref[@]}" "$src" "${DEST_ROOT}/${rel}/" || echo "Warning: some files from $src were not fully transferred"
    fi
  else
    echo "Skipping missing path: $src"
  fi
}

# Core personal data
echo "→ Backing up Documents..."
backup_if_exists "$HOME/Documents" "home/Documents"
echo "→ Backing up dotfiles..."
backup_if_exists "$HOME/dotfiles" "home/dotfiles"
echo "→ Backing up SSH keys..."
backup_if_exists "$HOME/.ssh" "home/.ssh"

# Useful shell/git state
echo "→ Backing up shell config..."
backup_if_exists "$HOME/.gitconfig" "home"
backup_if_exists "$HOME/.zshrc" "home"
backup_if_exists "$HOME/.zprofile" "home"
backup_if_exists "$HOME/.p10k.zsh" "home"
backup_if_exists "$HOME/.zsh_history" "home"

# Additional configs not tracked in git
echo "→ Backing up secrets and auth..."
backup_if_exists "$HOME/.config/secrets.zsh" "home/.config"
backup_if_exists "$HOME/.claude" "home/.claude"
backup_if_exists "$HOME/.gnupg" "home/.gnupg"
backup_if_exists "$HOME/.cmux" "home/.cmux"

# Package lists
if [[ "$DRY_RUN" == true ]]; then
  echo "[dry-run] Would save pacman explicit and AUR package lists"
else
  echo "→ Saving package lists..."
  pacman -Qqe > "${DEST_ROOT}/pkglist-explicit.txt"
  pacman -Qqm > "${DEST_ROOT}/pkglist-aur.txt"
  echo "Package lists saved."
fi

# Optional project backup
if [[ "$WITH_PROJECTS" == true ]]; then
  echo "→ Backing up Projects (excluding model weights and datasets)..."
  backup_if_exists "$HOME/Projects" "home/Projects" RSYNC_OPTS_PROJECTS
fi

# Write backup metadata
cat > "${DEST_ROOT}/BACKUP_INFO.txt" <<EOF
created_at=${TIMESTAMP}
host=${HOST}
user=${USER}
target=${TARGET}
with_projects=${WITH_PROJECTS}
dry_run=${DRY_RUN}
EOF

echo
echo "Backup completed."
echo "Saved to: $DEST_ROOT"
