#!/bin/sh
# Run a command on the NVIDIA GTX 1050 via PRIME render offload.
# The Intel iGPU still drives the display; only this app renders on the dGPU.
# Usage: prime-run <command> [args...]   e.g. prime-run glxinfo | grep renderer
export __NV_PRIME_RENDER_OFFLOAD=1
export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"
